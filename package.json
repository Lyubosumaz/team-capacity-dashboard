{
  "name": "team-capacity-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next && npx kill-port 3000 && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "test": "vitest run",
